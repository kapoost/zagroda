{
  "name": "zu",
  "private": true,
  "type": "module",
  "workspaces": [
    "game",
    "agent"
  ],
  "scripts": {
    "dev": "npm run dev -w game",
    "build": "tsx tools/dowody.ts && npm run build -w game",
    "test": "npm run test -w game",
    "typecheck": "tsc -p game/tsconfig.json --noEmit && tsc -p agent/tsconfig.json --noEmit && tsc -p tsconfig.tools.json",
    "gate": "tsx tools/gate.ts",
    "zu": "npm run zu -w agent --",
    "sim": "tsx tools/sim.ts",
    "npc-model": "tsx tools/npc-model.ts",
    "start": "tsx tools/start.ts",
    "dowody": "tsx tools/dowody.ts"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^5.7.2"
  }
}
